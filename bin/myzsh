#!/usr/bin/env python3
"""
myzsh - Zsh 主题和插件管理工具
"""

import os
import sys
import subprocess
import shutil
import json
from pathlib import Path
from typing import List, Optional, Dict, Any, Tuple
import readline
import termios
import tty
import signal

# 颜色定义
class Colors:
    GREEN = '\033[0;32m'
    BLUE = '\033[0;34m'
    YELLOW = '\033[1;33m'
    RED = '\033[0;31m'
    CYAN = '\033[1;36m'
    NC = '\033[0m'  # No Color
    
    @staticmethod
    def green(text: str) -> str:
        return f"{Colors.GREEN}{text}{Colors.NC}"
    
    @staticmethod
    def blue(text: str) -> str:
        return f"{Colors.BLUE}{text}{Colors.NC}"
    
    @staticmethod
    def yellow(text: str) -> str:
        return f"{Colors.YELLOW}{text}{Colors.NC}"
    
    @staticmethod
    def red(text: str) -> str:
        return f"{Colors.RED}{text}{Colors.NC}"
    
    @staticmethod
    def cyan(text: str) -> str:
        return f"{Colors.CYAN}{text}{Colors.NC}"


class MyZshManager:
    def __init__(self):
        self.myzsh_dir = os.environ.get('MYZSH_DIR', '')
        if not self.myzsh_dir:
            # 如果未设置，使用默认路径
            home = Path.home()
            self.myzsh_dir = str(home / '.myzsh')
        
        self.themes_dir = Path(self.myzsh_dir) / 'themes'
        self.plugins_dir = Path(self.myzsh_dir) / 'plugins'
        self.config_dir = Path(self.myzsh_dir) / 'config'
        self.config_myzsh_dir = self.config_dir / 'myzsh'
        self.editor_file = self.config_myzsh_dir / 'edit'
        self.theme_file = self.config_myzsh_dir / 'theme'
        self.theme_config_file = self.config_myzsh_dir / 'theme_config'
        self.plugins_file = self.config_myzsh_dir / 'plugins'
        
        self._ensure_dirs()
        
    def _ensure_dirs(self) -> None:
        """确保所有必要的目录存在"""
        self.themes_dir.mkdir(parents=True, exist_ok=True)
        self.plugins_dir.mkdir(parents=True, exist_ok=True)
        self.config_dir.mkdir(parents=True, exist_ok=True)
        self.config_myzsh_dir.mkdir(parents=True, exist_ok=True)
        
        # 确保编辑器配置文件存在
        if not self.editor_file.exists():
            editor = os.environ.get('EDITOR', 'vi')
            self.editor_file.write_text(f"EDITOR={editor}\n")
    
    def _get_editor(self) -> str:
        """获取编辑器命令"""
        if self.editor_file.exists():
            try:
                content = self.editor_file.read_text()
                # 简单解析 EDITOR=xxx
                for line in content.splitlines():
                    if line.startswith('EDITOR='):
                        return line.split('=', 1)[1].strip()
            except Exception:
                pass
        return os.environ.get('EDITOR', 'vi')
    
    def _set_editor(self, editor_cmd: str) -> None:
        """设置编辑器命令"""
        if not editor_cmd:
            print(Colors.red("错误: 请指定编辑器命令或路径"))
            print("用法: myzsh edit set <编辑器命令或路径>")
            return
        
        self._ensure_dirs()
        self.editor_file.write_text(f"EDITOR={editor_cmd}\n")
        print(f"编辑器已设置为: {editor_cmd}")
    
    def _clone_repo(self, repo_url: str, target_dir: Path) -> None:
        """克隆仓库（仅最新版本）"""
        repo_name = Path(repo_url).stem
        target_path = target_dir / repo_name
        
        if target_path.exists():
            print(f"目录已存在: {target_path}")
            response = input("是否更新? (y/N): ").strip().lower()
            if response in ('y', 'yes'):
                print("正在更新...")
                subprocess.run(['git', 'pull', '--depth=1'], cwd=target_path, check=False)
                print("更新完成!")
            else:
                print("跳过更新")
        else:
            print(f"正在克隆 {repo_name}...")
            subprocess.run(['git', 'clone', '--depth=1', repo_url, str(target_path)], check=False)
            print("克隆完成!")
    
    def _install_theme(self, repo_url: str) -> None:
        """安装主题"""
        self._ensure_dirs()
        self._clone_repo(repo_url, self.themes_dir)
    
    def _install_plugin(self, repo_url: str) -> None:
        """安装插件"""
        self._ensure_dirs()
        self._clone_repo(repo_url, self.plugins_dir)
    
    def _set_theme(self, theme_name: str) -> None:
        """设置主题"""
        if not theme_name:
            print(Colors.red("错误: 请指定主题名称"))
            print("用法: myzsh theme set <主题名>")
            return
        
        self._ensure_dirs()
        self.theme_file.write_text(f"ZSH_THEME={theme_name}\n")
        print(f"主题已设置为: {theme_name}")
    
    def _set_theme_config(self, config_path: str) -> None:
        """设置主题配置文件路径"""
        if not config_path:
            print(Colors.red("错误: 请指定配置文件路径"))
            print("用法: myzsh theme config <路径>")
            return
        
        self._ensure_dirs()
        self.theme_config_file.write_text(f"ZSH_THEME_CONFIG={config_path}\n")
        print(f"主题配置文件路径已设置为: {config_path}")
    
    def _get_plugins(self) -> List[str]:
        """获取当前启用的插件列表"""
        if self.plugins_file.exists():
            try:
                content = self.plugins_file.read_text()
                # 解析 plugins=(...)
                for line in content.splitlines():
                    if line.startswith('plugins=(') and line.endswith(')'):
                        plugins_str = line[9:-1].strip()
                        if plugins_str:
                            # 移除引号并分割
                            import shlex
                            return shlex.split(plugins_str)
                return []
            except Exception:
                return []
        return []
    
    def _write_plugins(self, plugins: List[str]) -> None:
        """写入插件列表"""
        plugins_str = ' '.join([f"'{p}'" for p in plugins])
        content = f"plugins=({plugins_str})\n"
        self.plugins_file.write_text(content)
    
    def _list_all_plugins(self) -> None:
        """列出所有已安装的插件"""
        self._ensure_dirs()
        enabled_plugins = self._get_plugins()
        
        print("所有已安装的插件:")
        
        if self.plugins_dir.exists():
            plugin_dirs = [d for d in self.plugins_dir.iterdir() if d.is_dir()]
            
            if plugin_dirs:
                disabled_plugins = []
                enabled_list = []
                
                for plugin_dir in plugin_dirs:
                    plugin_name = plugin_dir.name
                    if plugin_name in enabled_plugins:
                        enabled_list.append(plugin_name)
                    else:
                        disabled_plugins.append(plugin_name)
                
                # 显示未启用的插件
                for plugin in disabled_plugins:
                    print(f"  ○ {plugin}")
                
                # 显示已启用的插件
                for plugin in enabled_list:
                    print(f"  {Colors.green('●')} {plugin}")
                
                print(f"\n总计: {len(plugin_dirs)} 个插件 (已启用: {len(enabled_list)}, 未启用: {len(disabled_plugins)})")
            else:
                print("  (无已安装的插件)")
                print("\n总计: 0 个插件")
        else:
            print("  (无已安装的插件)")
            print("\n总计: 0 个插件")
    
    def _list_enabled_plugins(self) -> None:
        """列出已启用的插件"""
        self._ensure_dirs()
        enabled_plugins = self._get_plugins()
        
        print("已启用的插件:")
        if enabled_plugins:
            for plugin in enabled_plugins:
                print(f"  {Colors.green('●')} {plugin}")
            print(f"\n总计: {len(enabled_plugins)} 个插件")
        else:
            print("  (无)")
            print("\n总计: 0 个插件")
    
    def _list_plugins(self, mode: str = '') -> None:
        """列出插件"""
        if mode in ('true', 'on', 'enable'):
            self._list_enabled_plugins()
        elif not mode:
            self._list_all_plugins()
        else:
            print(Colors.red(f"错误: 未知参数 '{mode}'"))
            print("用法: myzsh plugin list [true|on|enable]")
            print("  - 无参数: 列出所有已安装的插件")
            print("  - true/on/enable: 列出已启用的插件")
    
    def _interactive_plugin_manager(self) -> None:
        """交互式插件管理"""
        self._ensure_dirs()
        
        # 获取已启用的插件列表
        enabled_plugins = self._get_plugins()
        
        # 获取所有插件
        all_plugins = []
        enabled_list = []
        disabled_list = []
        
        if self.plugins_dir.exists():
            for plugin_dir in self.plugins_dir.iterdir():
                if plugin_dir.is_dir():
                    plugin_name = plugin_dir.name
                    all_plugins.append(plugin_name)
                    if plugin_name in enabled_plugins:
                        enabled_list.append(plugin_name)
                    else:
                        disabled_list.append(plugin_name)
        
        # 重新排列：先显示已启用的，再显示未启用的
        display_plugins = enabled_list + disabled_list
        display_stat = [1] * len(enabled_list) + [0] * len(disabled_list)
        
        if not display_plugins:
            print("没有安装任何插件")
            return
        
        # 初始化选中状态：所有已启用的插件默认被选中
        selected = [i for i, stat in enumerate(display_stat) if stat == 1]
        current_index = 0
        total = len(display_plugins)
        
        # 保存终端设置
        fd = sys.stdin.fileno()
        old_settings = termios.tcgetattr(fd)
        
        def cleanup():
            termios.tcsetattr(fd, termios.TCSADRAIN, old_settings)
        
        signal.signal(signal.SIGINT, lambda s, f: (cleanup(), sys.exit(0)))
        
        # 隐藏光标
        sys.stdout.write('\033[?25l')
        sys.stdout.flush()
        
        try:
            while True:
                self._render_plugin_list(display_plugins, display_stat, selected, 
                                        current_index, total)
                
                # 读取按键
                tty.setraw(fd)
                key = sys.stdin.read(1)
                termios.tcsetattr(fd, termios.TCSADRAIN, old_settings)
                
                if key == '\x1b':  # ESC
                    key2 = sys.stdin.read(1)
                    if key2 == '[':
                        key3 = sys.stdin.read(1)
                        if key3 == 'A':  # 上键
                            current_index = (current_index - 1) % total
                        elif key3 == 'B':  # 下键
                            current_index = (current_index + 1) % total
                    else:
                        # ESC 键 - 取消
                        sys.stdout.write('\033[?25h')
                        sys.stdout.flush()
                        print("操作已取消")
                        return
                elif key == ' ':  # 空格键 - 切换选中
                    if current_index in selected:
                        selected.remove(current_index)
                        display_stat[current_index] = 0
                    else:
                        selected.append(current_index)
                        selected.sort()
                        display_stat[current_index] = 1
                elif key in ('\r', '\n'):  # Enter 键 - 确认
                    # 构建新的插件列表
                    new_enabled = [display_plugins[i] for i in selected]
                    self._write_plugins(new_enabled)
                    
                    sys.stdout.write('\033[?25h')
                    sys.stdout.flush()
                    print("插件配置已更新！")
                    print(f"已启用插件: {len(new_enabled)} 个")
                    if new_enabled:
                        print(f"插件列表: {' '.join(new_enabled)}")
                    return
                
        except Exception as e:
            sys.stdout.write('\033[?25h')
            sys.stdout.flush()
            print(f"错误: {e}")
        finally:
            termios.tcsetattr(fd, termios.TCSADRAIN, old_settings)
            sys.stdout.write('\033[?25h')
            sys.stdout.flush()
    
    def _render_plugin_list(self, display_plugins: List[str], display_stat: List[int],
                           selected: List[int], current_index: int, total: int) -> None:
        """渲染插件列表"""
        # 清屏并回到顶部
        sys.stdout.write('\033[2J\033[H')
        
        # 显示标题
        print(Colors.cyan("插件管理器 - 使用上下键移动，空格切换选中，Enter确认，ESC取消"))
        print(Colors.yellow("提示：选中的插件将会被启用"))
        print()
        
        # 获取终端行数
        try:
            import shutil
            term_lines = shutil.get_terminal_size().lines
            max_display_lines = term_lines - 8
            if max_display_lines < 5:
                max_display_lines = 5
        except:
            max_display_lines = 20
        
        # 计算显示范围
        start_line = 0
        end_line = total
        
        if total > max_display_lines:
            start_line = max(0, current_index - max_display_lines // 2)
            end_line = min(total, start_line + max_display_lines)
            if end_line - start_line < max_display_lines:
                start_line = max(0, end_line - max_display_lines)
        
        # 显示插件列表
        for i in range(start_line, end_line):
            plugin = display_plugins[i]
            stat = display_stat[i]
            is_selected = i in selected
            
            prefix = '●' if is_selected else '○'
            
            if i == current_index:
                # 当前选中行 - 蓝色高亮
                print(f"{Colors.blue('▶')} {prefix} {plugin}")
            else:
                # 非当前选中行
                if stat == 1:
                    # 已启用 - 绿色
                    print(f"  {Colors.green(prefix)} {plugin}")
                else:
                    # 未启用 - 普通颜色
                    print(f"  {prefix} {plugin}")
        
        # 显示统计信息
        print()
        enabled_count = sum(1 for s in display_stat if s == 1)
        print(Colors.yellow(f"已选中: {len(selected)} 个插件"))
        print(Colors.yellow(f"总计: {total} 个插件 (已启用: {enabled_count}, 未启用: {total - enabled_count})"))
    
    def _add_plugins(self, *plugin_names: str) -> None:
        """添加插件"""
        if not plugin_names:
            print(Colors.red("错误: 请指定要添加的插件名称"))
            print("用法: myzsh plugin add <插件名1> [插件名2] ...")
            return
        
        self._ensure_dirs()
        current_plugins = self._get_plugins()
        
        # 添加新插件（去重）
        added = []
        new_plugins = current_plugins.copy()
        for plugin in plugin_names:
            if plugin not in new_plugins:
                new_plugins.append(plugin)
                added.append(plugin)
        
        if not added:
            print("所有插件已存在，无需添加")
            return
        
        self._write_plugins(new_plugins)
        print(f"已添加插件: {' '.join(added)}")
    
    def _remove_plugins(self, *plugin_names: str) -> None:
        """移除插件"""
        if not plugin_names:
            print(Colors.red("错误: 请指定要移除的插件名称"))
            print("用法: myzsh plugin remove <插件名1> [插件名2] ...")
            return
        
        self._ensure_dirs()
        current_plugins = self._get_plugins()
        
        # 移除插件
        removed = []
        new_plugins = []
        for plugin in current_plugins:
            if plugin in plugin_names:
                removed.append(plugin)
            else:
                new_plugins.append(plugin)
        
        if not removed:
            print(f"未找到要移除的插件: {' '.join(plugin_names)}")
            return
        
        self._write_plugins(new_plugins)
        print(f"已移除插件: {' '.join(removed)}")
    
    def _edit_config(self, config_path: str) -> None:
        """编辑配置文件"""
        if not config_path:
            print(Colors.red("错误: 请指定配置文件路径"))
            print(f"用法: myzsh edit <路径>")
            print(f"提示: 路径相对于 {self.config_dir}/")
            print(f"例如: myzsh edit myzsh/theme")
            print(f"      myzsh edit myzsh/plugins")
            print(f"      myzsh edit custom/myconfig.conf")
            return
        
        self._ensure_dirs()
        editor_cmd = self._get_editor()
        full_path = self.config_dir / config_path
        
        # 确保目录存在
        full_path.parent.mkdir(parents=True, exist_ok=True)
        
        # 如果文件不存在，创建空文件
        if not full_path.exists():
            full_path.touch()
            print(f"已创建新文件: {full_path}")
        
        print(f"正在编辑: {full_path}")
        print(f"使用编辑器: {editor_cmd}")
        subprocess.run([editor_cmd, str(full_path)])
    
    def _show_help(self) -> None:
        """显示帮助信息"""
        help_text = f"""
用法: myzsh <命令> [参数]

命令:
    theme install <仓库地址>    安装主题
    theme set <主题名>          设置当前主题
    theme config <路径>         设置主题配置文件路径
    plugin install <仓库地址>   安装插件
    plugin                      交互式插件管理（上下选择，空格切换，Enter确认）
    plugin add <插件名>...      启用已安装的插件
    plugin remove <插件名>...   移除已启用的插件
    plugin list [true|on|enable] 列出插件（默认列出所有已安装的插件）
    edit <路径>                 编辑配置文件（路径相对于 {self.config_dir}/）
    edit set <编辑器命令>       设置默认编辑器
    help                        显示此帮助信息

交互式插件管理:
    上下键: 移动选择
    空格键: 切换选中状态（选中=启用）
    Enter键: 确认并保存
    ESC键: 取消操作

配置文件加载目录:
    {self.config_myzsh_dir}/         (myzsh 加载配置的目录)

配置文件示例:
    myzsh edit myzsh/theme          # 编辑主题设置
    myzsh edit myzsh/theme_config   # 编辑主题配置路径
    myzsh edit myzsh/plugins        # 编辑插件列表
    myzsh edit myzsh/edit           # 编辑编辑器设置
    myzsh edit custom/my.conf       # 编辑自定义配置文件

示例:
    myzsh theme install https://github.com/user/theme-repo.git
    myzsh plugin install https://github.com/user/plugin-repo.git
    myzsh theme set mytheme
    myzsh theme config /path/to/theme.config
    myzsh plugin                     # 进入交互式插件管理
    myzsh plugin add git zsh-autosuggestions
    myzsh plugin remove git
    myzsh plugin list                # 列出所有已安装的插件（○未启用，●已启用）
    myzsh plugin list true           # 列出已启用的插件（含统计）
    myzsh edit myzsh/plugins
    myzsh edit myzsh/theme
    myzsh edit set vim
    myzsh edit set /usr/bin/nano
    myzsh edit custom/myconfig.conf
"""
        print(help_text)
    
    def run(self, argv: List[str]) -> int:
        """运行主程序"""
        if len(argv) < 1:
            self._show_help()
            return 1
        
        cmd = argv[0]
        args = argv[1:]
        
        if cmd == 'theme':
            if len(args) < 1:
                print(Colors.red("错误: theme 需要指定子命令"))
                print("用法: myzsh theme <install|set|config> <参数>")
                return 1
            
            subcmd = args[0]
            subargs = args[1:]
            
            if subcmd == 'install':
                if len(subargs) < 1:
                    print(Colors.red("错误: 请指定主题仓库地址"))
                    print("用法: myzsh theme install <仓库地址>")
                    return 1
                self._install_theme(subargs[0])
            
            elif subcmd == 'set':
                if len(subargs) < 1:
                    print(Colors.red("错误: 请指定主题名称"))
                    print("用法: myzsh theme set <主题名>")
                    return 1
                self._set_theme(subargs[0])
            
            elif subcmd == 'config':
                if len(subargs) < 1:
                    print(Colors.red("错误: 请指定配置文件路径"))
                    print("用法: myzsh theme config <路径>")
                    return 1
                self._set_theme_config(subargs[0])
            
            else:
                print(Colors.red(f"错误: 未知 theme 子命令 '{subcmd}'"))
                print("可用子命令: install, set, config")
                return 1
        
        elif cmd == 'plugin':
            if len(args) == 0:
                # 无参数时进入交互模式
                self._interactive_plugin_manager()
            else:
                subcmd = args[0]
                subargs = args[1:]
                
                if subcmd == 'install':
                    if len(subargs) < 1:
                        print(Colors.red("错误: 请指定插件仓库地址"))
                        print("用法: myzsh plugin install <仓库地址>")
                        return 1
                    self._install_plugin(subargs[0])
                
                elif subcmd == 'add':
                    self._add_plugins(*subargs)
                
                elif subcmd == 'remove':
                    self._remove_plugins(*subargs)
                
                elif subcmd == 'list':
                    mode = subargs[0] if subargs else ''
                    self._list_plugins(mode)
                
                else:
                    print(Colors.red(f"错误: 未知 plugin 子命令 '{subcmd}'"))
                    print("可用子命令: install, add, remove, list")
                    print("直接运行 'myzsh plugin' 进入交互式模式")
                    return 1
        
        elif cmd == 'edit':
            if len(args) < 1:
                print(Colors.red("错误: edit 需要指定子命令或配置文件路径"))
                print("用法: myzsh edit <路径> 或 myzsh edit set <编辑器命令>")
                return 1
            
            subcmd = args[0]
            subargs = args[1:]
            
            if subcmd == 'set':
                if len(subargs) < 1:
                    print(Colors.red("错误: 请指定编辑器命令"))
                    print("用法: myzsh edit set <编辑器命令>")
                    return 1
                self._set_editor(subargs[0])
            else:
                self._edit_config(subcmd)
        
        elif cmd in ('help', '--help', '-h'):
            self._show_help()
        
        else:
            print(Colors.red(f"错误: 未知命令 '{cmd}'"))
            print("可用命令: theme, plugin, edit, help")
            self._show_help()
            return 1
        
        return 0


def main():
    manager = MyZshManager()
    sys.exit(manager.run(sys.argv[1:]))


if __name__ == '__main__':
    main()